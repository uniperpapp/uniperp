# Same Postgres as the indexer (Railway: reference the shared DB plugin).
DATABASE_URL=postgres://user:pass@host:5432/perpfactory

# The indexer's auto-generated GraphQL endpoint (Ponder default port 42069).
# Used to enumerate launched tokens. On Railway, point at the indexer service URL.
PONDER_GRAPHQL_URL=https://your-indexer.up.railway.app/graphql

# HTTP port for /dex + /trades + /health (Railway injects PORT automatically).
PORT=8080

# Data backend:
#   "gecko"       — GeckoTerminal-only (X Layer; Dexscreener doesn't index it)
#   "dexscreener" — Dexscreener for prices/mcap + GT for trades (default)
BACKEND=gecko

# GeckoTerminal network slug. For X Layer use "x-layer". (See
# https://api.geckoterminal.com/api/v2/networks for the full list.)
GT_NETWORK=x-layer

# Comma-separated base assets to price for the Markets rail. For X Layer that's
# WOKB + USDC.
BASE_TOKENS=0xe538905cf8410324e03a5a23c1c177a474d59b2b,0x74b7f16337b8972027f6196a17a631ac6de26d22

# Optional: extra non-factory tokens to track (e.g. a directly-deployed token
# whose pool isn't a Perpfactory launch). Format: "token:base,token:base".
EXTRA_TOKENS=
