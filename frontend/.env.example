# ─── Uniperp frontend (X Layer build) ─────────────────────────────────────

# Active chain. 196 = X Layer mainnet. The whole codebase is chain-aware via
# this single switch.
NEXT_PUBLIC_CHAIN_ID=196

# Live Perpfactory address on X Layer (the deployed one from
# `contracts/script/DeployXLayer.s.sol`). Replace if you deployed your own.
NEXT_PUBLIC_FACTORY_ADDRESS=0xf9424db38dab21434dfe7701626dbed186b4d584

# Indexer GraphQL endpoint (the Ponder service from `../indexer`).
# Locally: http://localhost:42069/graphql
# Production: https://your-indexer.up.railway.app/graphql
NEXT_PUBLIC_INDEXER_GRAPHQL_URL=https://your-indexer.up.railway.app/graphql

# dex-sync HTTP base — the URL of the `../dex-sync` service. Frontend hits
# /dex and /trades under this base.
NEXT_PUBLIC_DEX_DATA_URL=https://your-dex-sync.up.railway.app/dex

# Optional: client-side RPC for read calls. Defaults to https://rpc.xlayer.tech
# on X Layer (no key needed). Set this if you want a custom RPC (e.g. dRPC).
NEXT_PUBLIC_RPC_URL=

# Optional: Pinata IPFS gateway for token metadata + images. Falls back to the
# public ipfs.io gateway if unset.
NEXT_PUBLIC_PINATA_GATEWAY=

# Mainnet-only — leave empty on X Layer builds. (Migration is Ethereum-only.)
NEXT_PUBLIC_MIGRATION_ADDRESS=
NEXT_PUBLIC_V2_TOKEN_ADDRESS=
