# Required for `forge script ... --broadcast` (no leading 0x is also accepted by
# foundry, but `0x`-prefixed is safer for tooling roundtrips).
PRIVATE_KEY=0xyour_deployer_private_key_here

# Optional. Defaults to the public RPC if unset.
XLAYER_RPC_URL=https://rpc.xlayer.tech

# Optional. Only needed if you want to verify-via-Sourcify with the OKLink key.
# (Most Sourcify verifications work without one.)
OKLINK_API_KEY=
