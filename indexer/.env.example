# ─── perpfactory-indexer environment ──────────────────────────────────────
# Postgres for Ponder + dex-sync (shared). Railway provides this automatically;
# locally, point at a fresh DB.
DATABASE_URL=postgres://user:pass@host:5432/perpfactory

# X Layer RPC (chain 196). The public RPC `rpc.xlayer.tech` works for live
# indexing but FAILS on archive eth_getLogs queries — use dRPC for historical
# sync from genesis-ish: https://xlayer.drpc.org
PONDER_RPC_URL_1=https://xlayer.drpc.org

# Deployed Perpfactory address on X Layer (the live one is below; replace if you
# deployed your own).
FACTORY_ADDRESS=0xf9424db38dab21434dfe7701626dbed186b4d584

# Block to start indexing from — the deploy block of Perpfactory on X Layer.
# (Looked up via the factory's creation tx on OKLink.)
START_BLOCK=61031000

# Chain id (196 = X Layer mainnet).
CHAIN_ID=196
